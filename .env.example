# ========================================================
# AI NEWS INTELLIGENCE PLATFORM - ENVIRONMENT VARIABLES
# ========================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
DEBUG=True

# Application Mode: 'live' or 'demo' (demo works 100% offline without API keys)
APP_MODE=demo

# Database Configuration (SQLite by default - zero setup)
DATABASE_URL=sqlite:///./data/news_intelligence.db

# News API Configuration (Optional: get free key at https://newsapi.org)
NEWS_API_KEY=

# LLM / AI Configuration (Optional: Gemini or OpenAI API key)
# If left empty, the platform automatically uses the Built-in Offline Intelligence Engine
GEMINI_API_KEY=
OPENAI_API_KEY=

